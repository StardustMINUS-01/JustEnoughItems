{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${version}",

  "name": "${modName}",
  "description": "${modDescription}",
  "authors": [
    "StardustMINUS",
    "Stellar Remnants Team"
  ],
  "contact": {
    "homepage": "${homepageUrl}",
    "sources": "${githubUrl}"
  },

  "license": "MIT AND LGPL-3.0-or-later",
  "icon": "jei-icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "mezz.jei.fabric.JustEnoughItems"
    ],
    "client": [
      "mezz.jei.fabric.JustEnoughItemsClient"
    ],
    "jei_mod_plugin": [
      "mezz.jei.library.plugins.vanilla.VanillaPlugin",
      "mezz.jei.library.plugins.jei.JeiInternalPlugin",
      "mezz.jei.fabric.plugins.fabric.FabricGuiPlugin",
      "mezz.jei.gui.plugins.JeiGuiPlugin"
    ],
    "mezz_config_gui_plugin": [
      "mezz.jei.fabric.input.FabricKeyMappingConfigGuiPlugin"
    ]
  },
  "mixins": [
    "jei.mixins.json"
  ],
  "accessWidener" : "jei.accesswidener",

  "depends": {
    "fabricloader": "${fabricLoaderVersionRange}",
    "fabric-api": "${fabricApiVersionRange}",
    "${configModId}": "${mezzConfigFabricVersionRange}",
    "java": ">=${modJavaVersion}"
  },
  "suggests": {
    "${configGuiModId}": "${mezzConfigGuiFabricVersionRange}",
    "amecsapi": ">=${amecsVersionFabric}",
    "amecs_key_modifiers": ">=${amecsKeyModifiersVersionFabric}"
  },
  "breaks": {
    "${configGuiModId}": [
      "<${mezzConfigGuiMinimumVersion}",
      ">=${mezzConfigGuiMaximumVersion}"
    ]
  }
}
